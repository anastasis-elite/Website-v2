# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key (prefer the new secret key; legacy service role also works)
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Internal TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Must exactly match the redirect URI approved in TikTok Developer Portal.
TIKTOK_REDIRECT_URI=https://your-domain.example/api/internal/tiktok/callback

# AOS admin allowlist
AOS_ADMIN_EMAILS=anastasis.elite@gmail.com

# Connected calendars (server only; never use NEXT_PUBLIC_ for these values)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact URL as a Web application OAuth redirect in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=https://your-domain.example/api/calendars/google/callback
# Base64-encoded 32 random bytes. Back up securely; existing credentials require this key.
CALENDAR_CREDENTIAL_ENCRYPTION_KEY=
# Vercel Cron supplies Authorization: Bearer <CRON_SECRET> to /api/calendars/cron.
CRON_SECRET=
