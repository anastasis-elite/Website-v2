# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key (prefer the new secret key; legacy service role also works)
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
# Secure purchase invitations require this server key and a verified
# onboarding@anastasiselite.com sender domain in the isolated environment.
RESEND_API_KEY=

# Payment configuration. Use separate Stripe test prices and an isolated
# Supabase project/database for local and preview payment verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Uses the existing verified onboarding@anastasiselite.com sender for private
# account invitations. New customer checkout is blocked when delivery is absent.
RESEND_API_KEY=
EMBER_SUB_PRICE=
EMBER_YEAR_PRICE=
IGNITE_SUB_PRICE=
IGNITE_YEAR_PRICE=
PHOENIX_SUB_PRICE=
PHOENIX_YEAR_PRICE=
# One-time price/product metadata must explicitly contain access_months.
# Do not infer access duration from YEAR_PRICE names or checkout amounts.
# Vercel production is detected from VERCEL_ENV. For another production host only:
# PAYMENT_ENVIRONMENT=production
# Enable only after confirming this runtime points at a separate test database:
PAYMENT_TEST_DATABASE_ISOLATED=false

# Internal TikTok OAuth
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Must exactly match the redirect URI approved in TikTok Developer Portal.
TIKTOK_REDIRECT_URI=https://your-domain.example/api/internal/tiktok/callback

# AOS admin allowlist
AOS_ADMIN_EMAILS=anastasis.elite@gmail.com

# Connected calendars (server only; never use NEXT_PUBLIC_ for these values)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact URL as a Web application OAuth redirect in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=https://your-domain.example/api/calendars/google/callback
# Base64-encoded 32 random bytes. Back up securely; existing credentials require this key.
CALENDAR_CREDENTIAL_ENCRYPTION_KEY=
# Default Vercel Cron runs daily at 06:00 UTC; manual Refresh calendars is on-demand.
# A Pro/Enterprise cron override or external authenticated scheduler can run every 15 minutes.
# Vercel Cron supplies Authorization: Bearer <CRON_SECRET> to /api/calendars/cron.
CRON_SECRET=
