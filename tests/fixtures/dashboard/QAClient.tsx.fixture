'use client'
import { useEffect,useState } from 'react'
import Link from 'next/link'
import ClientDashboardNav from '@/components/navigation/ClientDashboardNav'
import IgniteDashboard from '@/components/program-dashboard/IgniteDashboard'
import EmberDashboard from '@/components/program-dashboard/EmberDashboard'
import PhoenixDashboard from '@/components/program-dashboard/PhoenixDashboard'
import WorkoutDashboard from '@/components/workout-dashboard/WorkoutDashboard'
import AdaptiveNutritionDashboard from '@/components/AdaptiveNutritionDashboard'
import RecoveryDashboardClient from '@/components/recovery/RecoveryDashboardClient'
import DailyCheckInForm from '@/components/DailyCheckInForm'
import ScheduleDashboardClient from '@/app/dashboard/schedule/ScheduleDashboardClient'
import DailyPlanCard from '@/components/DailyPlanCard'
import {createClient} from '@/lib/supabase/client'
import {buildDailyRecommendation} from '@/lib/dashboard/dailyRecommendation'
import {installQATransport} from './transport'
export default function QAClient({view,logic:initialLogic,schedule:initialSchedule,exercises}:any) {
 const [ready,setReady]=useState(false),[state,setState]=useState<any>(null)
 useEffect(()=>{
  const transport=installQATransport(initialLogic.program,initialSchedule.date,setState);setState(transport.state)
  const auth=createClient().auth
  const encode=(value:any)=>btoa(JSON.stringify(value)).replace(/=/g,'').replace(/\+/g,'-').replace(/\//g,'_')
  const token=encode({alg:'HS256',typ:'JWT'})+'.'+encode({sub:'local-qa',aud:'authenticated',role:'authenticated',exp:Math.floor(Date.now()/1000)+3600})+'.local-qa'
  void auth.setSession({access_token:token,refresh_token:'local-qa-only'}).then(()=>setReady(true))
  const navigate=(event:MouseEvent)=>{const anchor=(event.target as HTMLElement).closest('a');if(!anchor?.getAttribute('href')?.startsWith('/dashboard'))return;event.preventDefault();event.stopPropagation();const href=anchor.getAttribute('href')!;const next=href.includes('check-in')?'check-in':href.includes('nutrition')?'nutrition':href.includes('recovery')?'recovery':href.includes('workout')?'workout':href.includes('schedule')?'schedule':'home';window.location.href=`/local-dashboard-qa?view=${next}&tier=${initialLogic.program}`+(href.includes('#')?'#'+href.split('#')[1]:'')}
  document.addEventListener('click',navigate,true)
  window.BarcodeDetector = class { async detect() {return []} }
  Object.defineProperty(navigator,'mediaDevices',{configurable:true,value:{getUserMedia:async()=>{throw new DOMException('Denied in QA fixture','NotAllowedError')}}})
  return()=>{transport.restore();document.removeEventListener('click',navigate,true);auth.stopAutoRefresh()}
 },[initialLogic.program,initialSchedule.date])
 if(!ready||!state)return <p>Loading isolated local QA fixture…</p>
 const logic=structuredClone(initialLogic),schedule=structuredClone(initialSchedule)
 const checkIn=state.checkIn
 logic.assessments.dailyCompleted=typeof checkIn.energy==='number'
 logic.recoveryCheck={...logic.recoveryCheck,energy:checkIn.energy??null,stress:checkIn.stress??null,soreness:checkIn.soreness??null}
 logic.sleep={...logic.sleep,hours:checkIn.sleepHours??null,quality:checkIn.sleepQuality??null,logged:checkIn.sleepHours!=null||checkIn.sleepQuality!=null}
 logic.hydration={...logic.hydration,consumed:state.water,remaining:Math.max(0,111-state.water),status:state.water?'building':'needs_input'}
 logic.execution={...logic.execution,workoutComplete:state.session?.completed||false,workoutInProgress:state.session&&!state.session.completed,recoveryComplete:state.activities.length>0}
 if(state.meals.length)logic.nutrition.dataStatus='known'
 schedule.events=schedule.events.map((event:any)=>({...event,...state.scheduleOverrides[event.id]}))
 if(state.preferences)schedule.preferences={...schedule.preferences,...state.preferences}
 schedule.dailyRecommendation=buildDailyRecommendation(logic,schedule)
 const links=['home','check-in','nutrition','workout','recovery','schedule']
 return <div className="dashboard-client-shell" data-qa-date={schedule.date}><aside style={{padding:'12px 18px',background:'#402c21',color:'#fff',fontSize:14}}>Local QA fixture · disposable simulated data and saves · no customer account {links.map(name=><Link key={name} href={`/local-dashboard-qa?view=${name}&tier=${logic.program}`}>{name} </Link>)}</aside>
 {view==='home'?(logic.program==='ember'?<EmberDashboard logic={logic} schedule={schedule}/>:logic.program==='phoenix'?<PhoenixDashboard logic={logic} schedule={schedule} trackLabel="QA fixture"/>:<IgniteDashboard logic={logic} schedule={schedule}/>):view==='schedule'?<ScheduleDashboardClient initialSchedule={schedule}/>:<main className="schedule-page"><div className="schedule-shell"><h1>{view==='workout'?'Today’s workout':view==='recovery'?'Recovery':view==='check-in'?'Daily check-in':'Nutrition'}</h1><DailyPlanCard plan={schedule.dailyRecommendation} schedule={schedule} compact/>{view==='workout'?<WorkoutDashboard clientId="LOCAL-QA-ONLY" authUserId="local-qa" program={logic.program} workoutTitle="QA strength and movement" workoutStateLabel="Assigned plan" assignedWorkoutId="qa-assigned" assignedDayName="QA strength and movement" assignedExercises={exercises} showInteractiveWorkout hasSafetyFlags={false} safetyFlags={[]} previewTitle="Plan available" previewMessage="QA plan" logic={logic} muscleReadiness={[]} workoutHistory={state.session?[{...state.session,workout_date:schedule.date,day_name:"QA strength and movement"}]:[]} timezone="America/Chicago" memberEquipment={["*"]} showStrengthAssessmentOffer={false}/>:view==='check-in'?<DailyCheckInForm clientId="LOCAL-QA-ONLY" program={logic.program} initial={checkIn} cycleTrackingEnabled={false} stayOnSave/>:view==='recovery'?<RecoveryDashboardClient logic={logic} clientId="LOCAL-QA-ONLY" program={logic.program} cycleTrackingEnabled={false} checkInInitial={checkIn} trends={[]} recentActivities={state.activities}/>:<AdaptiveNutritionDashboard program={logic.program} logic={logic} recipes={[]}/>}</div></main>}
 <ClientDashboardNav program={logic.program}/>
 </div>
}
