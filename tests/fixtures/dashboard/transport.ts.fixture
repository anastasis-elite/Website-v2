// Disposable browser transport. Unknown requests fail closed; no real service is contacted.
import {getScheduleEventCapabilities,scheduleEventVersion} from '@/lib/schedule/actions'
import type {ScheduleEvent} from '@/lib/schedule/types'
export function installQATransport(tier: string, date: string, onChange: (state: any) => void, scheduleEvents?: ScheduleEvent[]) {
 const key=`local-qa-dashboard-v2:${tier}:${date}${scheduleEvents?':schedule':''}`
 const initial={meals:[],session:null,checkIn:{},activities:[],water:0,waterIds:[],scheduleOverrides:{},preferences:null,dailyGuide:{date,activities:{}},...(scheduleEvents?{checkIn:{energy:3},water:111,session:{id:'qa-existing-session',completed:true,exercise_logs:[]},activities:[{id:'qa-existing-recovery',activity_type:'breathing',duration_minutes:5,log_date:date}],dailyGuide:{date,activities:{schedule:{status:'reviewed'}}},scheduleWrites:0,scheduleRequests:[]}: {})}
 const state={...initial,...JSON.parse(localStorage.getItem(key)||'{}')}
 const persist=()=>{localStorage.setItem(key,JSON.stringify(state));onChange(structuredClone(state))}
 const original=window.fetch
 const log=()=>({id:'10000000-0000-4000-8000-000000000001',client_id:'LOCAL-QA-ONLY',log_date:date,calories:1800,protein:110,carbs:200,fats:60,water_oz:111,water_consumed_oz:state.water,fiber_target_g:25,sodium_target_mg:1500,potassium_target_mg:2600,magnesium_target_mg:320,calcium_target_mg:150,iron_target_mg:18,zinc_target_mg:8,selenium_target_mcg:55,choline_target_mg:425,vitamin_a_target_mcg:700,vitamin_c_target_mg:75,vitamin_d_target_mcg:15,vitamin_e_target_mg:15,vitamin_k_target_mcg:90,b1_target_mg:1.1,b2_target_mg:1.1,b3_target_mg:14,b5_target_mg:5,b6_target_mg:1.3,b9_target_mcg:400,b12_target_mcg:2.4})
 const remaining=()=>({nutrition_log_id:log().id,calories_remaining:1800-state.meals.length*120,protein_remaining_g:110-state.meals.length*20,carbs_remaining_g:200-state.meals.length*6,fat_remaining_g:60})
 window.fetch=async(input:any,options:any)=>{
  const url=typeof input==='string'?input:input instanceof URL?input.href:input.url
  const body=options?.body?JSON.parse(options.body):{}
  if(url.startsWith('https://local-qa.invalid/')) {
   if(url.includes('/auth/v1/user'))return Response.json({id:'local-qa',aud:'authenticated',role:'authenticated',email:'disposable@example.invalid',app_metadata:{},user_metadata:{}})
   if(url.includes('/auth/v1/token')) {const encode=(value:any)=>btoa(JSON.stringify(value)).replace(/=/g,'').replace(/\+/g,'-').replace(/\//g,'_');return Response.json({access_token:encode({alg:'HS256',typ:'JWT'})+'.'+encode({sub:'local-qa',aud:'authenticated',role:'authenticated',exp:Math.floor(Date.now()/1000)+3600})+'.local-qa',refresh_token:'local-qa-only',token_type:'bearer',expires_in:3600,user:{id:'local-qa',aud:'authenticated',role:'authenticated',app_metadata:{},user_metadata:{}}})}
   if(url.includes('/rest/v1/nutrition_logs'))return Response.json(log())
   if(url.includes('/rest/v1/nutrition_log_totals_by_block'))return Response.json(state.meals.length?[{day_block:'morning',calories_eaten:state.meals.length*120,protein_eaten_g:state.meals.length*20,carbs_eaten_g:state.meals.length*6,fat_eaten_g:0}]:[])
   if(url.includes('/rest/v1/macro_entries'))return Response.json([])
   if(url.includes('/rest/v1/meal_entries'))return Response.json(state.meals.map((meal:any)=>({...meal,entry_state:'confirmed',grams:meal.grams||170,foods:{...meal.foods,food_nutrients:{fiber_g:0,sodium_mg:36,calcium_mg:110,iron_mg:0.1}}})))
   if(url.includes('/rest/v1/nutrient_reference_values'))return Response.json([])
   if(url.includes('/rest/v1/nutrition_log_remaining'))return Response.json(remaining())
   return Response.json({error:'Unimplemented local QA database request.'},{status:501})
  }
  if(!url.startsWith('/api/'))return original(input,options)
  let payload:any
  if(url.startsWith('/api/calendars/events'))payload={events:[],calendars:[]}
  else if(url.startsWith('/api/calendars'))payload={connections:[],preferences:{timezone:'America/Chicago',default_calendar_id:null,preferred_start:'07:00',preferred_end:'21:00',buffer_minutes:10},google_configured:false,icloud_configured:false}
  else if(url.includes('search-foods'))payload={foods:[{id:'20000000-0000-4000-8000-000000000001',name:'Plain Greek yogurt',calories:120,protein_g:20,carbs_g:6,fat_g:0}]}
  else if(url.includes('serving-options'))payload={servingOptions:[{id:'30000000-0000-4000-8000-000000000001',label:'Container',grams:170,unit:'container'}]}
  else if(url.includes('today-meals'))payload={meals:state.meals,remaining:remaining()}
  else if(url.includes('barcode'))payload={found:false,message:'No product found. Search manually instead.'}
  else if(url.includes('photo-estimate'))payload={available:false,message:'Photo estimation is unavailable. Search / manual entry is still available.'}
  else if(url.includes('recurring-foods'))payload={patterns:[],candidates:[]}
  else if(url.includes('suggested-foods'))payload={state:'ready',suggestions:[{foodId:'20000000-0000-4000-8000-000000000001',name:'Plain Greek yogurt',serving:'1 container',contribution:'20g protein',reason:'A protein option for your next meal.'}],message:state.meals.length?'Based on your logged intake.':'No meals logged yet. These ideas use today’s targets; they do not assume what you have eaten.'}
  else if(url.includes('nutrient-insights'))payload={insights:[]}
  else if(url.includes('supplement-recommendation'))payload={recommendation:null}
  else if(url.includes('add-meal')) {
   if(tier==='ember')return Response.json({error:'Meal logging is unavailable in Ember.'},{status:403})
   state.meals.push({...body,id:'qa-meal-'+state.meals.length,meal_name:body.mealName,meal_period:body.mealPeriod,serving_amount:body.servingAmount,serving_unit:body.servingUnit,entry_source:body.entrySource,foods:{id:body.foodId,name:'Plain Greek yogurt'},calories:120,protein_g:20,carbs_g:6,fat_g:0,created_at:new Date().toISOString()});persist();payload={success:true,mealEntry:state.meals.at(-1),remaining:remaining()}
  } else if(url.includes('workout-log')) {
   if(options?.method==='POST'){state.session={id:'local-qa-session',updated_at:new Date().toISOString(),exercise_logs:body.exercise_logs,completed:body.completed};persist()}
   payload={success:true,session:state.session}
  } else if(url==='/api/workout-set-log') {state.manualSets=body.sets;persist();payload={success:true}} else if(url==='/api/daily-check-in') {
   if(state.failNextCheckIn){state.failNextCheckIn=false;persist();return Response.json({error:'Check-in could not be saved. Try again.'},{status:503})}
   state.checkIn={...state.checkIn,...body};state.checkInWrites=(state.checkInWrites||0)+1;persist();payload={success:true}
  }
  else if(url==='/api/dashboard/activities') {
   if(body.date!==date || !['check-in','water','schedule','nutrition','workout','recovery'].includes(body.activityId) || !['defer','skip','resume','review'].includes(body.action))return Response.json({error:'Invalid isolated QA daily activity.'},{status:400})
   if(state.failNextActivity){state.failNextActivity=false;persist();return Response.json({error:'The activity could not be saved. Try again.'},{status:503})}
   state.dailyGuide={date,activities:{...state.dailyGuide?.activities}}
   if(body.action==='resume')delete state.dailyGuide.activities[body.activityId]
   else state.dailyGuide.activities[body.activityId]=body.action==='defer'?{status:'deferred',until:new Date(Date.now()+2*60*60*1000).toISOString()}:{status:body.action==='skip'?'skipped':'reviewed'}
   persist();payload={success:true,dailyGuide:state.dailyGuide}
  }
  else if(url==='/api/nutrition/add-water') {if(!state.waterIds.includes(body.submissionId)){state.water+=body.ounces;state.waterIds.push(body.submissionId);persist()}payload={success:true,nutritionLog:log()}}
  else if(url==='/api/recovery/activity') {state.activities.push({id:'qa-activity-'+state.activities.length,activity_type:body.activityType,duration_minutes:body.minutes,log_date:date});persist();payload={success:true}}
  else if(url==='/api/dashboard/preferences') {state.preferences={...(state.preferences||{}),...body};persist();payload={success:true}}
  else if(scheduleEvents && url.startsWith('/api/schedule/')) {
   const match=url.match(/^\/api\/schedule\/([^/]+)(?:\/(complete|defer))?$/)
   const id=body.eventId || (match?decodeURIComponent(match[1]):null)
   const action=url==='/api/schedule/dismiss'?'dismiss':body.action || (match?.[2]==='complete'?'complete':match?.[2]==='defer'?'move':body.status==='skipped'?'skip':null)
   state.scheduleRequests.push({id,action,url,method:options?.method});persist()
   if(state.scheduleDelayMs)await new Promise(resolve=>setTimeout(resolve,state.scheduleDelayMs))
   if(state.failNextSchedule){state.failNextSchedule=false;persist();return Response.json({error:'Schedule change could not be saved. Try again.'},{status:503})}
   const base=scheduleEvents.find(event=>event.id===id)
   if(!base || body.date!==date)return Response.json({error:'Synthetic schedule item was not found for today.'},{status:404})
   const current={...base,...state.scheduleOverrides[id]},capabilities=getScheduleEventCapabilities(current)
   if(body.expected_version && body.expected_version!==scheduleEventVersion(current))return Response.json({error:'This activity changed. Refresh to review its saved outcome.'},{status:409})
   if(!(action==='complete'?capabilities.canComplete:action==='skip'?capabilities.canSkip:action==='move'?capabilities.canReschedule:action==='dismiss'?capabilities.canDismiss:false))return Response.json({error:'This schedule change is unavailable.'},{status:409})
   let fields:any
   const updated_at=new Date(Date.now()+state.scheduleWrites).toISOString()
   if(action==='complete')fields={status:'completed',completed_at:updated_at,updated_at}
   else if(action==='skip')fields={status:'skipped',completed_at:null,updated_at}
   else if(action==='dismiss')fields={dismissed_from_today:date}
   else {
    if(!Number.isFinite(Date.parse(body.start_at)) || Date.parse(body.end_at)<=Date.parse(body.start_at))return Response.json({error:'Choose a valid new time.'},{status:400})
    fields={status:'scheduled',adjusted_start_at:body.start_at,adjusted_end_at:body.end_at,adjusted_duration_minutes:(Date.parse(body.end_at)-Date.parse(body.start_at))/60000,completed_at:null,suggested:false,updated_at}
   }
   state.scheduleOverrides[id]={...state.scheduleOverrides[id],...fields};state.scheduleWrites++;persist();payload={success:true,event:{...current,...fields}}
  }
  else if(url==='/api/schedule/plan') {state.scheduleOverrides[body.eventId]=body.action==='skip'?{status:'skipped'}:{adjusted_start_at:body.start_at,adjusted_end_at:body.end_at,suggested:false};persist();payload={success:true}}
  else return Response.json({error:`Unimplemented isolated QA request: ${url}`},{status:501})
  return Response.json(payload)
 }
 return {state,restore:()=>{window.fetch=original}}
}
